{
  "name": "askarr",
  "version": "0.5.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:bot": "tsx watch src/bot/index.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:bot": "tsx src/bot/index.ts",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --env-file-if-exists=.env --import tsx --test \"src/**/*.test.ts\"",
    "test:db": "node --env-file-if-exists=.env.test --import tsx --test \"src/**/*.test.ts\"",
    "test:db:setup": "docker exec askarr-dev-pg createdb -U askarr askarr_test || true",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:tag": "changeset tag && git push --follow-tags"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@prisma/client": "^6.19.3",
    "@t3-oss/env-nextjs": "^0.13.11",
    "better-auth": "^1.6.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "grammy": "^1.45.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.17.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
